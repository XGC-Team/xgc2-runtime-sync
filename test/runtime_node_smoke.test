<launch>
  <arg name="control_socket"/>
  <node pkg="periodic_sync"
        type="swarm_runtime_node"
        name="swarm_runtime_node"
        output="screen">
    <param name="control_socket" value="$(arg control_socket)"/>
    <param name="team_id" value="test_team"/>
    <param name="session_id" value="smoke_session"/>
    <param name="task_id" value="smoke_task"/>
    <param name="self_id" value="uav_test"/>
    <param name="frequency_hz" value="20.0"/>
    <param name="poll_rate_hz" value="100.0"/>
    <param name="start_delay_s" value="0.05"/>
    <param name="auto_start" value="true"/>
    <param name="clock_provider" value="mock"/>
    <param name="clock_phase" value="preflight"/>
    <param name="ground_time_source" value="mock_ground_station"/>
    <param name="max_clock_offset_ms" value="2.0"/>
    <param name="mock_clock_ok" value="true"/>
    <param name="mock_clock_offset_ns" value="1000000"/>
    <param name="mock_clock_uncertainty_ns" value="500000"/>
    <param name="mock_clock_source" value="mock_ground_station"/>
    <rosparam param="ros1_adapters">
deny_by_default: true
rules:
  - name: smoke_solution
    topic: /local_solution
    channel: solution
    schema_id: user.solution.v1
    payload_type: bytes
    enabled: true
    max_payload_bytes: 4096
    required: false
    </rosparam>
  </node>

  <test test-name="runtime_node_smoke"
        pkg="periodic_sync"
        type="runtime_node_smoke_test"
        time-limit="15.0">
    <param name="control_socket" value="$(arg control_socket)"/>
  </test>
</launch>
