<launch>
  <!-- Same-host scenario: one coordinator, three participant processes and the
       test node. Participant 3 announces itself late and later ignores the
       triggers 6..11. The test reads this scenario back from the parameter
       server, so the values below are the single definition of it. -->
  <arg name="gate_param" value="/sync_test/observer_connected"/>

  <node pkg="periodic_sync" type="sync_coordinator" name="sync_coordinator" output="screen">
    <rosparam command="load" file="$(find periodic_sync)/test/config/formation_topics.yaml"/>
    <param name="participant_count" value="3"/>
    <param name="first_participant_id" value="1"/>
    <param name="sync_period" value="0.2"/>
    <param name="timeout_threshold_ms" value="120.0"/>
    <param name="max_consecutive_timeouts" value="3"/>
    <param name="recovery_good_cycles" value="3"/>
  </node>

  <node pkg="periodic_sync" type="fake_sync_participant" name="participant_1" output="screen">
    <rosparam command="load" file="$(find periodic_sync)/test/config/formation_topics.yaml"/>
    <param name="gate_param" value="$(arg gate_param)"/>
    <param name="participant_id" value="1"/>
    <param name="computation_ms" value="2.0"/>
    <param name="ready_delay" value="0.0"/>
    <param name="silent_from_sequence" value="0"/>
    <param name="silent_count" value="0"/>
  </node>

  <node pkg="periodic_sync" type="fake_sync_participant" name="participant_2" output="screen">
    <rosparam command="load" file="$(find periodic_sync)/test/config/formation_topics.yaml"/>
    <param name="gate_param" value="$(arg gate_param)"/>
    <param name="participant_id" value="2"/>
    <param name="computation_ms" value="20.0"/>
    <param name="ready_delay" value="0.0"/>
    <param name="silent_from_sequence" value="0"/>
    <param name="silent_count" value="0"/>
  </node>

  <node pkg="periodic_sync" type="fake_sync_participant" name="participant_3" output="screen">
    <rosparam command="load" file="$(find periodic_sync)/test/config/formation_topics.yaml"/>
    <param name="gate_param" value="$(arg gate_param)"/>
    <param name="participant_id" value="3"/>
    <param name="computation_ms" value="8.0"/>
    <param name="ready_delay" value="1.0"/>
    <param name="silent_from_sequence" value="6"/>
    <param name="silent_count" value="6"/>
  </node>

  <test test-name="same_host_protocol" pkg="periodic_sync" type="sync_coordinator_rostest" time-limit="90.0">
    <rosparam command="load" file="$(find periodic_sync)/test/config/formation_topics.yaml"/>
    <param name="gate_param" value="$(arg gate_param)"/>
  </test>
</launch>
